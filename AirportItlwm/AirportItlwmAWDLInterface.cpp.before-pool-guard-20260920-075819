static void
airplayLifeProperty(IOService *service, const char *key, UInt8 value)
{
    OSData *data = OSData::withBytes(&value, sizeof(value));

    if (data != nullptr) {
        service->setProperty(key, data);
        data->release();
    }
}

bool
AirportItlwmAWDLInterface::attach(IOService *provider)
{
    airplayLifeProperty(this, "AIRPLAYLifeAttachEnter", 1);
    IOLog(
        "AIRPLAY AWDL LIFE: attach ENTER this=%p provider=%p\n",
        this,
        provider
    );

    bool result =
        IO80211VirtualInterface::attach(provider);

    IOLog(
        "AIRPLAY AWDL LIFE: attach RETURN=%d this=%p\n",
        result,
        this
    );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeAttachReturn",
        result ? 1 : 0
    );

    return result;
}


const char *
AirportItlwmAWDLInterface::getBSDNamePrefix(void)
{
    return "awdl";
}


bool
AirportItlwmAWDLInterface::start(IOService *provider)
{
    airplayLifeProperty(this, "AIRPLAYLifeStartEnter", 1);

    IOLog(
        "AIRPLAY AWDL LIFE: start ENTER this=%p provider=%p\n",
        this,
        provider
    );

    bool result =
        IO80211VirtualInterface::start(provider);

    IOLog(
        "AIRPLAY AWDL LIFE: start RETURN=%d this=%p\n",
        result,
        this
    );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeStartReturn",
        result ? 1 : 0
    );

    if (!result)
        return false;

    AirportItlwm *owner =
        OSDynamicCast(AirportItlwm, provider);

    if (owner == nullptr) {
        IOLog(
            "AIRPLAY AWDL SKY: provider is not AirportItlwm\n"
        );
        airplayLifeProperty(
            this,
            "AIRPLAYLifeSkywalkOwner",
            0
        );
        return false;
    }

    airplayLifeProperty(
        this,
        "AIRPLAYLifeSkywalkOwner",
        1
    );

    IOSkywalkPacketBufferPool *txPool = nullptr;
    IOSkywalkTxSubmissionQueue *txQueue = nullptr;

    bool resourcesReady =
        AirportItlwm::createSkywalkTxResources(
            owner,
            &txPool,
            &txQueue
        );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeSkywalkTxResources",
        resourcesReady ? 1 : 0
    );

    if (!resourcesReady ||
        txPool == nullptr ||
        txQueue == nullptr) {
        IOLog(
            "AIRPLAY AWDL SKY: TX resource creation failed "
            "pool=%p queue=%p\n",
            txPool,
            txQueue
        );

        if (txQueue != nullptr)
            txQueue->release();

        if (txPool != nullptr)
            txPool->release();

        return false;
    }

    struct IOSkywalkEthernetInterface::RegistrationInfo registration;
    memset(&registration, 0, sizeof(registration));

    bool registrationInitialized =
        initRegistrationInfo(
            &registration,
            1,
            sizeof(registration)
        );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeSkywalkRegInfo",
        registrationInitialized ? 1 : 0
    );

    if (!registrationInitialized) {
        IOLog(
            "AIRPLAY AWDL SKY: initRegistrationInfo failed\n"
        );
        txQueue->release();
        txPool->release();
        return false;
    }

    /*
     * Broadcom Proximity/AWDL registration fields established from
     * Sonoma IOSkywalkFamily / AppleBCMWLAN reverse engineering.
     *
     * Leave every other field exactly as initRegistrationInfo()
     * initialized it.
     */
    UInt32 value32;

    value32 = 3;
    memcpy(registration.pad + 0x0c, &value32, sizeof(value32));

    value32 = 2;
    memcpy(registration.pad + 0x14, &value32, sizeof(value32));

    value32 = 0x80;
    memcpy(registration.pad + 0x24, &value32, sizeof(value32));
    memcpy(registration.pad + 0x28, &value32, sizeof(value32));

    value32 = 0x40;
    memcpy(registration.pad + 0x3c, &value32, sizeof(value32));

    value32 = 0x594;
    memcpy(registration.pad + 0x48, &value32, sizeof(value32));
    memcpy(registration.pad + 0x4c, &value32, sizeof(value32));

    /*
     * Reconstruct the same locally-administered unicast MAC used
     * when this AWDL virtual interface is created.
     */
    IOEthernetAddress controllerAddress;
    memset(&controllerAddress, 0, sizeof(controllerAddress));

    IOReturn addressResult =
        owner->getHardwareAddress(&controllerAddress);

    if (addressResult != kIOReturnSuccess) {
        IOLog(
            "AIRPLAY AWDL SKY: getHardwareAddress failed 0x%x\n",
            addressResult
        );
        txQueue->release();
        txPool->release();
        return false;
    }

    memcpy(
        registration.pad + 0x108,
        &controllerAddress,
        6
    );

    registration.pad[0x108] =
        (registration.pad[0x108] & 0xFC) | 0x02;

    /*
     * IOSkywalkFamily treats the third argument as the number of
     * queues in this registration path.  First live experiment:
     * one TX submission queue backed by the shared packet pool.
     */
    IOSkywalkPacketQueue *queues[1];
    queues[0] = txQueue;

    IOReturn registrationResult =
        registerEthernetInterface(
            &registration,
            queues,
            1,
            txPool,
            txPool,
            0
        );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeSkywalkRegistered",
        registrationResult == kIOReturnSuccess ? 1 : 0
    );

    IOLog(
        "AIRPLAY AWDL SKY: registerEthernetInterface "
        "RETURN=0x%x this=%p\n",
        registrationResult,
        this
    );

    /*
     * IOSkywalkFamily retains the registered queue and pools.
     * Drop the factory references regardless of registration result.
     */
    txQueue->release();
    txPool->release();

    if (registrationResult != kIOReturnSuccess)
        return false;

    IOLog(
        "AIRPLAY AWDL LIFE: Skywalk registered; "
        "publishing synchronously then setRunningState(false) "
        "this=%p\n",
        this
    );

    registerService(kIOServiceSynchronous);
    setRunningState(false);

    return true;
}


IOReturn
