    IOLog(
        "AIRPLAY AWDL LIFE: enable ENTER this=%p value=%u\n",
        this,
        (unsigned int)value
    );

    IOReturn result =
        IO80211VirtualInterface::enable(value);

    IOLog(
        "AIRPLAY AWDL LIFE: enable RETURN=0x%x this=%p\n",
        result,
        this
    );

    airplayLifeProperty(
        this,
        "AIRPLAYLifeEnableReturn",
        result == kIOReturnSuccess ? 1 : 0
    );

    return result;
}

